{
  "name": "occtl",
  "version": "0.1.0",
  "description": "Node.js N-API binding for OCCT-Light, a modular C-ABI wrapper around Open CASCADE Technology.",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/Open-Cascade-SAS/OCCT-Light",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Open-Cascade-SAS/OCCT-Light.git"
  },
  "author": "Capgemini Engineering Research and Development",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "prebuilds",
    "src",
    "binding.gyp",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "install": "node -e \"process.exit(0)\"",
    "generate": "tsc -p tools/tsconfig.json && node dist-tools/generate_facade.js --abi ../../build/abi.json",
    "build:native": "node-gyp configure build",
    "build:ts": "tsc -p tsconfig.json",
    "build": "npm run generate && npm run build:native && npm run build:ts",
    "prebuild": "prebuildify --napi --strip",
    "test": "vitest run --pool=forks",
    "test:smoke": "vitest run --pool=forks tests/smoke.test.ts",
    "test:coverage": "vitest run --pool=forks tests/coverage.test.ts"
  },
  "dependencies": {
    "bindings": "^1.5.0",
    "node-addon-api": "^8.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "node-gyp": "^10.2.0",
    "prebuildify": "^6.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
