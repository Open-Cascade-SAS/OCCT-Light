<Project Sdk="Microsoft.NET.Sdk">
  <!-- SPDX-License-Identifier: AGPL-3.0-or-later -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>OcctL.Parity</RootNamespace>
    <AssemblyName>OcctL.Parity</AssemblyName>
    <!-- The parity runner uses reflection-driven JsonSerializer.Serialize for its
         small ad-hoc output object. AOT is not a goal for this diagnostic tool. -->
    <IsAotCompatible>false</IsAotCompatible>
    <!-- dotnet run can execute the DLL directly; the parity tool does not need
         a native apphost, and apphost code-signing is fragile under macOS
         sandboxed build agents. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\api\OcctL.csproj" />
  </ItemGroup>
</Project>
